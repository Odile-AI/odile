#!/bin/sh
# Odile commit-msg gate: a message must not carry a private literal.
#
# `.githooks/pre-push` catches a literal on the way out, but by then the commit
# object exists: removing it means `git commit --amend` or a rebase, and once the
# commit is merged the literal is in every outgoing range until someone rewrites
# history. This hook is the cheaper half. Git hands the message file as `$1`
# before the commit object is written, so the literal never enters a message.
#
# It reads the same one list as `make leak` and the pre-push hook — HQ's
# `docs/ops/leak-forbid.txt`; the repository publishes none — and honours the
# same allowlist. The message surface's path is its label, `commit-message`
# (the name the pre-push scan uses), so a `leak-allow.tsv` row whose path is
# `commit-message` and whose digest pins the value waives exactly that value on
# this surface: a different value is still a finding, and the row's reason must
# not quote the value (the self-satisfying rule).
#
# A clone carries no list (the repository does not publish one), so on a clone
# this hook prints `forbid list absent` and lets the commit through, exactly as
# the pre-push hook does: there is nothing to scan against. Supply the list at
# the documented path to arm it.
#
# Git does not version hook installation, so enable it once per clone:
#
#     make hooks
#
# The deliberate bypass is:
#
#     git commit --no-verify
#
# It is for a message already known clean, never for "the hook is inconvenient":
# the pre-push hook scans the same message surface again, and CI scans every
# blob with the same list.
set -eu

if [ "$#" -lt 1 ] || [ -z "$1" ]; then
    printf 'commit-msg: no message file argument; refusing.\n' >&2
    exit 1
fi
MESSAGE=$1
# Git invokes the hook from the worktree root, but a manual run may not; the
# path is resolved before the `cd` below so a relative argument still lands.
case "$MESSAGE" in
    /*) ;;
    *) MESSAGE="$(pwd)/$MESSAGE" ;;
esac

cd "$(git rev-parse --show-toplevel)"

if [ ! -f "$MESSAGE" ]; then
    printf 'commit-msg: message file %s is missing; refusing.\n' "$MESSAGE" >&2
    exit 1
fi

PYTHON=${PYTHON:-/usr/bin/python3}
SCANNER=tools/leak_scan.py

FORBID=docs/ops/leak-forbid.txt
if [ ! -f "$FORBID" ]; then
    printf 'commit-msg: forbid list absent: %s\n' "$FORBID" >&2
    printf 'commit-msg: the message was not scanned for private literals.\n' >&2
    printf 'commit-msg: the repository does not publish the list; supply it at that path\n' >&2
    printf 'commit-msg: to arm this hook (the pre-push hook and CI scan with the same bytes).\n' >&2
    exit 0
fi
if [ ! -f "$SCANNER" ]; then
    printf 'commit-msg: %s is missing; refusing to commit an unscanned message.\n' "$SCANNER" >&2
    exit 1
fi

# Git hands the hook the whole message file. With `-v` (or
# `commit.verbose=true`) that file also carries the staged diff, appended after
# git's own scissors line, and that diff is not part of the message. Cut the
# file at that line and scan everything above it. The tree surfaces are the
# pre-push hook's job, and it scans them per path, so a value waived at its own
# path is not a message literal.
#
# A scissors line is `<comment prefix> <marker>` and nothing else. The prefix
# is whatever `core.commentChar` / `core.commentString` is configured to: one
# punctuation character by default, but git also accepts a string (`//`) and a
# single alphanumeric character (`A`, `1`, `d`), and builds its own `-v`
# template and scissors line from that prefix. A message that merely quotes the
# marker text (`see ---- >8 ----`), or even types the comment-prefixed line
# itself, is not git's appended part and is scanned in full: its lines land in
# the commit object, so a literal after the quote must be refused here or the
# push later wedges at the pre-push scan. The marker is git's only when the
# lines below it are blank or carry the same prefix (git writes its `Do not
# modify...` / `Everything below...` comment lines there) and the first line
# that breaks that run begins `diff --git `. That test is made before the
# prefix test, because an alphanumeric comment character makes `diff --git`
# itself look like a comment line. The prefix is read off the candidate line
# itself, so `core.commentChar` (including `auto`) needs no separate lookup,
# and `git stripspace` still sees the lines above the cut.
#
# Everything above the marker is scanned, comment lines included. `-m` and `-F`
# clean the message with `cleanup=whitespace`, which *keeps* a line beginning
# with the comment character: that line lands in the commit object, so a
# literal on it must be refused here or the push later wedges at the pre-push
# scan. On the editor path the template's own `#` lines are scanned too, a
# deliberate superset — a literal in an editor comment is refused although the
# default editor cleanup would drop the line. Scanning more than git records is
# safe; scanning less is the bug this hook exists to prevent.
#
# `git stripspace` normalises whitespace and is deliberately *not* given
# `--strip-comments`: that would drop the `-m`/`-F` lines git keeps.
BODY=$(
    awk '
        { line[NR] = $0 }
        END {
            marker = "------------------------ >8 ------------------------"
            cut = 0
            for (i = 1; i <= NR; i++) {
                if (line[i] !~ /[^[:space:]] ------------------------ >8 ------------------------$/)
                    continue
                prefix = substr(line[i], 1, length(line[i]) - length(marker) - 1)
                for (j = i + 1; j <= NR; j++) {
                    if (line[j] ~ /^diff --git /) { cut = i; break }
                    if (line[j] ~ /^[[:space:]]*$/) continue
                    if (index(line[j], prefix) == 1) continue
                    break
                }
            }
            for (i = 1; i <= NR; i++) {
                if (cut > 0 && i >= cut)
                    break
                print line[i]
            }
        }
    ' "$MESSAGE" | git stripspace
)

# The scanner prints its report on stdout; on a finding it goes to stderr so
# `git commit` shows it even when it is summarising. On a clean message there
# is nothing to say.
if ! report=$(printf '%s\n' "$BODY" | "$PYTHON" "$SCANNER" --stdin --label commit-message \
        --forbid-file "$FORBID"); then
    printf '%s\n' "$report" >&2
    printf '\ncommit-msg: a private literal is in the commit message; the commit did not happen.\n' >&2
    printf 'commit-msg: rewrite the message, or waive the value with a commit-message row in\n' >&2
    printf 'commit-msg: leak-allow.tsv whose digest pins it and whose reason does not quote it.\n' >&2
    exit 1
fi
