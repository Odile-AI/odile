# Odile test bench — non-secret runtime values (ODL-339).
#
# One EnvironmentFile for both bench units, so the "second set of values" is
# a file an operator can read, not seven Environment= lines inside a unit.
# Nothing here is a secret: the seed config and the seed key are LoadCredential
# paths in odile-bench-seed.service, and the database holds no production rows.
#
# Installed at /etc/odile-bench/bench.env (0644 root:root) by
# deploy/bench/deploy_bench.py. Edit this file, then run the deployer — a
# second apply converges and prints `nothing to do`.
ODILE_BIND=127.0.0.1
ODILE_PORT={{APP_PORT}}
ODILE_DB={{STATE}}/waitlist.db
ODILE_ATTEST={{STATE}}/attestation.json
ODILE_ROADMAP={{STATE}}/roadmap.html
ODILE_SEED_BIND=127.0.0.1
ODILE_SEED_PORT={{SEED_PORT}}
ODILE_SEED_REBUILDS={{STATE}}/seed-rebuilds.json
