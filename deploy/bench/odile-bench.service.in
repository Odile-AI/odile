[Unit]
Description=Odile test bench — the account site at test.odile.fyi (ODL-339)
Documentation=https://test.odile.fyi/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=odile
Group=odile
WorkingDirectory={{ROOT}}/current
StateDirectory={{STATE_NAME}}
StateDirectoryMode=0700
EnvironmentFile={{ETC}}/bench.env
# The account site's own values (ODL-341). They are app-only — the seed
# service reads none of them — so they live here rather than in the shared
# bench.env: where a confirmation mail is queued, the key that signs the one
# session cookie, the host a mailed link points at (never the request's Host
# header) and the suffix the machine's name is built from.
Environment=ODILE_OUTBOX={{STATE}}/outbox
Environment=ODILE_SESSION_KEY_FILE={{STATE}}/account-session.key
Environment=ODILE_ACCOUNT_HOST=https://test.odile.fyi
Environment=ODILE_TENANT_DOMAIN=test.odile.fyi
# ODL-949: the bench is the one host that drains `accounts` and orders the
# machine a registration asks for; production's door is closed until A7.
Environment=ODILE_REGISTER=open
Environment=PYTHONUNBUFFERED=1
# runs as root (the + prefix) because /dev/sev-guest is 0600; the bench writes
# its own report, never the production one
ExecStartPre=+/usr/bin/python3 {{ROOT}}/current/attest.py {{STATE}}/attestation.json
ExecStart=/usr/bin/python3 {{ROOT}}/current/app.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
