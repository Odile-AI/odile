[Unit]
Description=Odile test bench — the account site at test.odile.fyi (ODL-339)
Documentation=https://test.odile.fyi/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=odile
Group=odile
WorkingDirectory={{ROOT}}/current
StateDirectory={{STATE_NAME}}
StateDirectoryMode=0700
EnvironmentFile={{ETC}}/bench.env
Environment=PYTHONUNBUFFERED=1
# runs as root (the + prefix) because /dev/sev-guest is 0600; the bench writes
# its own report, never the production one
ExecStartPre=+/usr/bin/python3 {{ROOT}}/current/attest.py {{STATE}}/attestation.json
ExecStart=/usr/bin/python3 {{ROOT}}/current/app.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
