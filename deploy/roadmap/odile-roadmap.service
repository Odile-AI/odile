# Odile — the roadmap page generator. ODL-490.
#
# Committed source of truth for /etc/systemd/system/odile-roadmap.service.
# scripts/deploy.sh installs it; odile-roadmap.timer runs it every fifteen minutes.
#
# Root, because the board's SQLite file lives under /root/.hermes and the state
# file lives in /var/lib/odile. The generator reads the board through a
# `mode=ro` connection and writes exactly one file, atomically, so a failed run
# leaves the previous page in place.
[Unit]
Description=Odile roadmap page — regenerate from docs/backlog.yaml and the board
Documentation=https://odile.fyi/roadmap
After=odile.service

[Service]
Type=oneshot
User=root
# The page is generated from the live HQ checkout, not the deployed tree:
# docs/backlog.yaml is edited on HQ every pulse, while /opt/odile is refreshed
# only by scripts/deploy.sh. Reading /opt made the "source of truth" page serve
# the last deploy's backlog (measured 2026-11-27: the page served 24 November
# while HQ held 27 November). The deployed tree still runs the web app; the
# page reads the same HQ files the team reads.
WorkingDirectory=%h/odile
# The footer names the HQ revision the page was generated from. The source
# file is refreshed every tick: the deploy-time writer went stale on 24 Nov
# while the page kept rendering, so the old footer named a week-old revision.
ExecStartPre=/bin/sh -c '/usr/bin/git -C %h/odile rev-parse --short HEAD > /var/lib/odile/roadmap-source'
ExecStart=/usr/bin/python3 %h/odile/tools/roadmap_page.py --backlog %h/odile/docs/backlog.yaml --out /var/lib/odile/roadmap.html --source-file /var/lib/odile/roadmap-source
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The board database lives in root's home. A `mode=ro` open of a WAL database
# still writes the -shm index beside it, and with /root read-only SQLite fails
# with "unable to open database file" whenever the index has to be rebuilt
# (measured 2026-11-17: 0/5 runs passed without the writable directory, 3/3
# with it). The database itself is opened read-only and never written.
ProtectHome=read-only
ReadWritePaths=/var/lib/odile
ReadWritePaths=/root/.hermes/kanban/boards/odile
