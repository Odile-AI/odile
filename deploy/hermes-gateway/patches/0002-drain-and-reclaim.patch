+def _kanban_attempts(authority):
+    """``(session_id, worker_or_None, policy)`` for every card attempt this authority is running.
+
+    ``worker`` is None while the turn is still being spawned (``_managed_spawning``): there is no
+    child to signal yet, but the card's run is already the owner's to hand back. The map the drain
+    enumerates is ``authority._managed_policies``, which ``execute_managed`` keeps for exactly the
+    live Kanban attempts (populated before ``@`` expansion, popped when the turn settles).
+    """
+    workers = getattr(authority, '_managed_workers', {}) or {}
+    for sid, policy in list((getattr(authority, '_managed_policies', {}) or {}).items()):
+        if getattr(policy, 'kanban_json', None) is None:
+            continue
+        yield sid, workers.get(sid), policy
+
+
+def kanban_turn_count(runner):
+    """Live Kanban card attempts across every served authority (a subset of ``managed_turn_count``).
+
+    The stop drain subtracts these: a card attempt is handed back (``worker_lost`` + reclaim), not
+    waited out to ``agent.restart_drain_timeout`` — waiting is what left a card's submitter redialling
+    ``Gateway draining: not_ready`` past its own 180 s patience (ADR-008 §3.5).
+    """
+    from gateway.session_authorities import all_authorities
+    return sum(1 for authority in all_authorities(runner) for _sid, _worker, _policy in _kanban_attempts(authority))
+
+
+async def hand_off_kanban_turns(runner, reason, *, write_timeout: float = 10.0) -> int:
+    """Hand every in-flight card attempt back and stop its turn (ADR-008 §3.5).
+
+    The write is the board's: ``worker_lost`` on the run, the run closed ``reclaimed``, the card
+    returned to its source lane with ``consecutive_failures`` reset — so a host restart cannot leave
+    a card owned or block it on the breaker. Only then is the turn stopped, so the admission settles
+    with the drain cause while the owner still serves. Bounded per card (a busy board must not hold
+    the stop); returns how many attempts this call closed.
+    """
+    from gateway.session_kanban import record_drain_handoff
+    from gateway.session_authorities import all_authorities
+    closed = 0
+    for authority in all_authorities(runner):
+        for sid, worker, policy in _kanban_attempts(authority):
+            if worker is not None and worker.kanban_handed_off:
+                continue
+            pid, bound = None, False
+            if worker is not None:
+                worker.kanban_handed_off = True
+                bound = worker.worker is not None
+                pid = (worker.worker or (worker.process.pid,))[0]
+            try:
+                await asyncio.wait_for(
+                    asyncio.to_thread(record_drain_handoff, policy, reason, pid=pid, bound=bound),
+                    timeout=write_timeout)
+            except Exception:
+                import logging
+                logging.getLogger(__name__).warning(
+                    'Kanban drain hand-off write failed for %s', sid, exc_info=True)
+                continue
+            closed += 1
+            if worker is not None:
+                worker.stop_cause = reason
+                try:
+                    worker.control({'type': 'stop'})
+                except Exception:
+                    import logging
+                    # Stop latched the deadline even when the queue was full: the read loop
+                    # escalates on the latch alone (``ManagedWorker.next_frame``).
+                    logging.getLogger(__name__).debug(
+                        'Kanban drain Stop not queued for %s', sid, exc_info=True)
+    return closed
+
+
