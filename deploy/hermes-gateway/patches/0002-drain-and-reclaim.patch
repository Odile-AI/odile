+def record_drain_handoff(policy, reason, *, pid=None, bound=False):
+    """A planned drain hands this card attempt back instead of leaving it owned.
+
+    A stop the host chose (``systemctl --user restart``, a takeover, SIGTERM) starts a drain
+    whose envelope an ordinary card run cannot finish inside. The owner writes the same
+    ``worker_lost`` evidence a lost worker gets — so the board and the next worker know why the
+    attempt ended — and closes the run ``reclaimed`` itself: the card returns to the lane its
+    ``claimed`` event names (``ready``, or ``review`` for a reviewer run) and
+    ``consecutive_failures`` is reset, because a host restart is not the card's failure and the
+    breaker would otherwise block a card that merely happened to be in flight. The dispatcher
+    re-claims it on its next tick; no human step (ADR-008 §3.5).
+
+    Returns True only when this call closed the attempt. Never raises (the drain must not depend
+    on a board write) and drops the note when the card has already moved past the run.
+    """
+    try:
+        context = json.loads(policy.kanban_json or 'null')
+        if not context:
+            return False
+        from hermes_cli.kanban_db_connect import connect_closing
+        from hermes_cli import kanban_db as kb
+        run_id = int(context['run_id'])
+        task_id = context['task_id']
+        claim_lock = context['claim_lock']
+        now = int(time.time())
+        with connect_closing(Path(context['db'])) as conn, kb.write_txn(conn):
+            row = conn.execute(
+                'SELECT status, current_run_id, claim_lock, worker_pid, claim_expires, last_heartbeat_at '
+                'FROM tasks WHERE id=?', (task_id,)).fetchone()
+            if (row is None or row['status'] != 'running' or row['current_run_id'] != run_id
+                    or row['claim_lock'] != claim_lock):
+                return False
+            note = f'managed worker lost: {str(reason)[:80]}'
+            payload = {'reason': str(reason)[:200], 'claim_lock': claim_lock, 'run_id': run_id,
+                       'pid': pid, 'bound': bool(bound), 'drain': True}
+            kb._append_event(conn, task_id, 'worker_lost', payload, run_id=run_id)
+            retry_status = kb._retry_status_for_run(conn, task_id, run_id)
+            error = f'stale_lock={claim_lock} [{note}]'
+            # Close the run first: _end_run reads (and clears) current_run_id.
+            kb._end_run(conn, task_id, outcome='reclaimed', status='reclaimed',
+                        error=error[:500], metadata=dict(payload, attempt_note=note))
+            cur = conn.execute(
+                "UPDATE tasks SET status = ?, claim_lock = NULL, claim_expires = NULL, "
+                "worker_pid = NULL, worker_started_at = NULL, current_run_id = NULL, "
+                "consecutive_failures = 0, last_failure_error = NULL "
+                "WHERE id = ? AND status = 'running' AND claim_lock IS ?",
+                (retry_status, task_id, claim_lock),
+            )
+            if cur.rowcount != 1:
+                return False
+            kb._append_event(conn, task_id, 'reclaimed', {
+                'stale_lock': claim_lock, 'worker_pid': None,
+                'claim_expires': row['claim_expires'], 'last_heartbeat_at': row['last_heartbeat_at'],
+                'now': now, 'host_local': True, 'heartbeat_stale': False,
+                'retry_status': retry_status, 'worker_lost': str(reason)[:200],
+            }, run_id=run_id)
+        return True
+    except Exception:
+        import logging
+        logging.getLogger(__name__).exception('kanban drain hand-off failed')
+        return False
+
+
