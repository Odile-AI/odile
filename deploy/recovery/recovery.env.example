# Odile factory recovery — secrets. Store this file in 1Password and a USB.
# The recovery script reads this file; do not edit unless a token was rotated.
# Generate the real file with:
#   /usr/bin/python3 scripts/factory_recovery_kit.py
#
# The passphrase is exactly the 64-character value from the backup kit, no
# trailing newline. The R2 values are the Object Read & Write token on the
# hermes-hq-backup bucket. The Cloudflare token needs DNS:Edit on the zone.

RESTIC_PASSWORD='<64-character restic passphrase>'
R2_ACCESS_KEY_ID='<R2 Access Key ID>'
R2_SECRET_ACCESS_KEY='<R2 Secret Access Key>'
R2_ENDPOINT='https://<32-hex-account-id>.eu.r2.cloudflarestorage.com'
CLOUDFLARE_ACCOUNT_ID='<32-hex account id>'
CLOUDFLARE_DNS_TOKEN='<Cloudflare DNS:Edit token>'
ZONE_ID='<32-hex Cloudflare zone id>'
