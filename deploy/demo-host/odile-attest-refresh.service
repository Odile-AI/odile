[Unit]
# Refresh the cached SEV-SNP report that /attestation and /verify read on the
# public demo tenant (t_145ca49c). Root, because /dev/sev-guest is 0600.
#
# The tenant image writes the served copy once at boot (ODL-397: the boot
# report, which does not change while the machine runs). The demo's approved
# row in docs/CLAIMS.md says the report refreshes every five minutes, so the
# demo carries the same timer HQ's /verify has had since ODL-322 — the tenant's
# own attest.py, run again, into the file Caddy already serves.
Description=Refresh the cached SEV-SNP attestation report for /attestation and /verify
ConditionPathExists=/dev/sev-guest

[Service]
Type=oneshot
Environment=ODILE_ATTEST_PY=/usr/local/lib/odile/attest.py
ExecStart=/usr/local/lib/odile/attest-refresh.sh
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/odile
